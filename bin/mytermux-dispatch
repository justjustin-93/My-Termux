#!/data/data/com.termux/files/usr/bin/env bash
# Thin dispatcher for all my-termux CLI commands.
# Sourced/installed once by install.sh; each my-* binary is a symlink to this file
# (or a copy) whose $0 name determines which subcommand to run.

set -e

APP_DIR="${MYTERMUX_APP_DIR:-$HOME/my-termux/app}"
PY="${MYTERMUX_PYTHON:-python}"

# Determine invocation name and normalize it so both old `my-` prefixed
# names and new unprefixed names work. Examples: my-chat -> chat, chat -> chat
self="$(basename "$0")"
# strip leading start- and my- prefixes if present
norm="${self#start-}"
norm="${norm#my-}"

case "$norm" in
    termux|termux-dispatch|my-termux|dashboard) sub="dashboard" ;;
    start)   sub="start" ;;
    chat)    sub="chat" ;;
    menu)    sub="menu" ;;
    status)  sub="status" ;;
    scan)    sub="scan" ;;
    sync)    sub="sync" ;;
    fix)     sub="fix" ;;
    export)  sub="export" ;;
    import)  sub="import" ;;
    resume)  sub="resume" ;;
    media)   sub="media" ;;
    cloud)   sub="cloud" ;;
    *)       sub="dashboard" ;;
esac

# make sure the source tree is importable
export PYTHONPATH="$APP_DIR:${PYTHONPATH:-}"

exec "$PY" -m mytermux "$sub" "$@"
